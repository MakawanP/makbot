# Required: your Gemini API key (from Google AI Studio)
GEMINI_API_KEY=

# Optional: model names
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: if set, visitors must enter this password to chat or talk
MAKBOT_PASSWORD=

# Optional: your own model server (OpenAI-compatible API: vLLM, Ollama, llama.cpp, LM Studio)
# Must be reachable from the internet (e.g. through a Cloudflare Tunnel), not just localhost.
SELF_HOSTED_BASE_URL=        # e.g. https://gemma.example.com/v1
SELF_HOSTED_API_KEY=
SELF_HOSTED_MODEL=gemma-4-26b-a4b   # the exact model name your server expects
SELF_HOSTED_PRIORITY=first          # first = your model answers, Gemini is backup; last = reverse
SELF_HOSTED_TIMEOUT_MS=60000        # how long to wait for your server before using Gemini
